# Budget application settings
# Copy to .env for local development only. Production uses
# /etc/budget-app/budget.env with permissions restricted to root/budgetapp.

APP_ENV=development
DEMO_MODE=true
DEMO_DB_PATH=./data/demo.db
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Generate independent random values; never reuse these examples as secrets.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
# Ubuntu:     openssl rand -hex 32
APP_SECRET=<random-256-bit-value>
SESSION_SECRET=<different-random-256-bit-value>
ENCRYPTION_KEY=<different-random-256-bit-value>

# Required before the first production start. Remove it from the production
# environment after setup succeeds, then restart the API service.
BOOTSTRAP_TOKEN=

# Production database: Oracle MySQL HeatWave on the private OCI network.
# Use the internal FQDN that matches the database TLS certificate.
DB_HOST=mysql.internal.example
DB_PORT=3306
DB_NAME=budget
DB_USER=budgetapp
DB_PASSWORD=<database-password>
DB_SSL_REQUIRED=true
# Phase 6 production baseline: authenticate the HeatWave certificate chain.
# VERIFY_IDENTITY is preferred when the certificate identifies DB_HOST. OCI service-defined
# HeatWave certificates may use a generic server identity; in that case pin the endpoint CA
# outside the repository and use VERIFY_CA. REQUIRED is not accepted for production.
DB_SSL_MODE=VERIFY_CA
DB_SSL_CA=/etc/budget-app/heatwave-ca.pem


# Phase 2B bank connections. Keep credentials server-side only.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Keep local/test installs on sandbox. Switch the deployed server to production only
# after Plaid Production access is approved and `python -m app.cli plaid-readiness`
# has been reviewed. Existing Sandbox Items must be re-linked in Production.
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=https://budget.example.com/plaid/oauth
PLAID_WEBHOOK_URI=https://budget.example.com/api/v1/plaid/webhook
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Phase 3C-2 Ask Budget. The API key remains server-side and is never returned
# to the browser. Leave AI_ENABLED=false until a provider key is configured.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback provider settings:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_TIMEOUT_SECONDS=45
AI_MAX_TOOL_CALLS=4
AI_REQUESTS_PER_MINUTE=12

# Phase 4 Stage 1 identity and private-family access.
# PUBLIC_APP_URL is used when Budget needs to construct invitation/reset links.
PUBLIC_APP_URL=http://localhost:5173

# Optional Google OpenID Connect. For local development, register the exact
# redirect URI below in the Google OAuth client. Production must use HTTPS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Optional SMTP delivery for invitations and password resets. When disabled,
# administrators can copy private invitation/reset links from Settings instead.
EMAIL_DELIVERY=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Phase 4 Stage 2 reliability / logical backups. Production should use a path
# writable only by budgetapp (the supplied systemd unit uses /var/lib/budget-app/backups).
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_MAX_AGE_HOURS=36
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql

# Phase 4 Stage 6 bounded maintenance. Financial source records are never
# automatically deleted; these limits only apply to expired auth/audit history
# and reproducible report-export blobs.
MAINTENANCE_AUTH_RETENTION_DAYS=7
MAINTENANCE_AUDIT_RETENTION_DAYS=365
MAINTENANCE_EXPORT_RETENTION_DAYS=90
MAINTENANCE_EXPORT_MAX_PER_USER=50
MAINTENANCE_MIN_FREE_GB=2

# Phase 5A request hardening. Keep this slightly above the Stage 7 2 MB CSV
# payload limit; the production Nginx template independently caps bodies at 5 MB.
SECURITY_MAX_REQUEST_BYTES=4500000
